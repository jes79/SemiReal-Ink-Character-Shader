/* 쉐이더 랩 UI 스타일. 색은 여기 변수만 바꾸면 전체가 바뀐다 */
:root {
    --lab-bg: rgba(14, 17, 23, 0.88);
    --lab-bg-light: rgba(255, 255, 255, 0.06);
    --lab-line: rgba(255, 255, 255, 0.10);
    --lab-text: rgb(226, 231, 239);
    --lab-text-dim: rgb(140, 150, 165);
    --lab-accent: rgb(110, 168, 255);
    --lab-accent-dark: rgb(44, 82, 140);
}

.lab-root {
    flex-grow: 1;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--lab-text);
    font-size: 13px;
}

/* ---------- 와이프 ---------- */
.wipe-overlay {
    position: absolute;
    top: 0; bottom: 0; right: 0;
    left: 50%;
}
.wipe-overlay Image {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.wipe-handle {
    position: absolute;
    top: 0; bottom: 0;
    width: 24px;
    margin-left: -12px;
    left: 50%;
    align-items: center;
    justify-content: center;
    cursor: resize-horizontal;
}
.wipe-handle__line {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}
.wipe-handle__grip {
    width: 14px;
    height: 44px;
    border-radius: 7px;
    background-color: rgb(255, 255, 255);
}

.side-label {
    position: absolute;
    top: 12px;
    padding: 4px 10px;
    border-radius: 4px;
    background-color: var(--lab-bg);
    -unity-font-style: bold;
}

/* ---------- 패널 ---------- */
.side-panel {
    position: absolute;
    left: 12px; top: 12px; bottom: 12px;
    width: 380px;
    background-color: var(--lab-bg);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lab-line);
    overflow: hidden;
}
.panel-header {
    padding: 14px 16px 8px 16px;
}
.panel-title {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--lab-accent);
}
.panel-subtitle {
    color: var(--lab-text-dim);
    font-size: 12px;
}
.panel-header .ghost-button {
    position: absolute;
    right: 12px; top: 14px;
}
.panel-footer {
    padding: 8px 16px 12px 16px;
    font-size: 11px;
    color: var(--lab-text-dim);
    white-space: normal;
    border-top-width: 1px;
    border-color: var(--lab-line);
}

.tab-bar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 12px 6px 12px;
    border-bottom-width: 1px;
    border-color: var(--lab-line);
}
/* 기본 버튼·드롭다운: 런타임 기본 테마는 밝은 회색이라 어두운 패널에 맞게 바꾼다 */
.lab-root Button {
    background-color: var(--lab-bg-light);
    border-color: var(--lab-line);
    border-radius: 4px;
    color: var(--lab-text);
}
.lab-root Button:hover { border-color: var(--lab-accent); }
.lab-root .unity-base-popup-field__input {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--lab-line);
    border-radius: 4px;
}
.lab-root .unity-base-popup-field__text { color: var(--lab-text); }
.lab-root .unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--lab-text); }

.lab-root .tab-button {
    margin: 2px;
    padding: 4px 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: var(--lab-bg-light);
    color: rgb(180, 190, 205);
}
.lab-root .tab-button:hover { color: var(--lab-text); }
.lab-root .tab-button--selected {
    background-color: var(--lab-accent-dark);
    color: rgb(255, 255, 255);
}
.tab-content {
    flex-grow: 1;
}
.tab-content .unity-scroll-view__content-container {
    padding: 4px 16px 16px 16px;
}

/* ---------- 내용 ---------- */
.section-title {
    margin-top: 14px;
    margin-bottom: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--lab-accent);
    letter-spacing: 1px;
}
.help {
    font-size: 11px;
    color: var(--lab-text-dim);
    white-space: normal;
    margin-bottom: 6px;
}
.row {
    flex-direction: row;
    flex-wrap: wrap;
}
.lab-root .segment {
    flex-grow: 1;
    margin: 2px;
    padding: 5px 6px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--lab-line);
    background-color: var(--lab-bg-light);
    color: var(--lab-text);
}
.lab-root .segment:hover { border-color: var(--lab-accent); }
.lab-root .segment--selected {
    background-color: var(--lab-accent-dark);
    border-color: var(--lab-accent);
}
.wide-button { margin: 2px; }
.lab-root .ghost-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--lab-line);
    color: var(--lab-text-dim);
}

.lab-toggle { margin: 2px 0; }
.lab-toggle .unity-toggle__text { color: var(--lab-text); }
.lab-toggle__help {
    margin-left: 22px;
    margin-top: -2px;
    margin-bottom: 4px;
}

.lab-root Label { color: var(--lab-text); }
.lab-root .help { color: var(--lab-text-dim); }
.lab-root .section-title { color: var(--lab-accent); }
.lab-root .unity-base-field__label { color: var(--lab-text); min-width: 110px; }

.card {
    margin: 3px 0;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--lab-line);
    background-color: var(--lab-bg-light);
}
.card:hover { border-color: var(--lab-accent); }
.card--selected {
    border-color: var(--lab-accent);
    background-color: rgba(110, 168, 255, 0.16);
}
.card__title { -unity-font-style: bold; }
.lab-root .card__text {
    font-size: 11px;
    color: var(--lab-text-dim);
    white-space: normal;
}

.lab-root .time-label {
    -unity-text-align: middle-right;
    color: var(--lab-text-dim);
    font-size: 11px;
}

.lab-root .expand-button {
    position: absolute;
    left: 12px; top: 12px;
    padding: 6px 12px;
    background-color: var(--lab-bg);
    color: var(--lab-accent);
    border-color: var(--lab-line);
    -unity-font-style: bold;
}
