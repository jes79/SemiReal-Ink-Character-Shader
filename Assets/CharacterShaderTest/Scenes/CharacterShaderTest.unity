  lightingPresets:
  - displayName: "\uD658\uACBD \uAE30\uBCF8"
    description: "\uD658\uACBD \uD504\uB9AC\uC14B\uC5D0 \uC815\uD574 \uB454 \uD587\uBE5B \uADF8\uB300\uB85C"
    useEnvironmentSun: 1
    sunAngles: {x: 35, y: 180}
    intensityScale: 1
    accentLights: 0
  - displayName: "\uC815\uBA74\uAD11"
    description: "\uCE74\uBA54\uB77C \uCABD\uC5D0\uC11C \uBE44\uCD94\uB294 \uBE5B. \uADF8\uB9BC\uC790\uAC00 \uAC70\uC758 \uC5C6\uC5B4 \uD3C9\uD3C9\uD558\uAC8C \uBCF4\uC778\uB2E4"
    useEnvironmentSun: 0
    sunAngles: {x: 25, y: 180}
    intensityScale: 1
    accentLights: 0
  - displayName: "45\xB0 \uD0A4 \uB77C\uC774\uD2B8"
    description: "\uC778\uBB3C \uC0AC\uC9C4\uC758 \uAE30\uBCF8 \uAC01\uB3C4. \uC5BC\uAD74 \uD55C\uCABD\uC5D0 \uC0BC\uAC01\uD615 \uBE5B\uC774 \uC0DD\uAE34\uB2E4"
    useEnvironmentSun: 0
    sunAngles: {x: 40, y: 135}
    intensityScale: 1
    accentLights: 0
  - displayName: "\uCE21\uBA74\uAD11"
    description: "\uC606\uC5D0\uC11C \uBE44\uCDB0 \uBA85\uC554 \uACBD\uACC4(2\uB2E8 \uBA85\uC554\xB7SSS)\uAC00 \uAC00\uC7A5 \uC798 \uBCF4\uC778\uB2E4"
    useEnvironmentSun: 0
    sunAngles: {x: 10, y: 90}
    intensityScale: 1
    accentLights: 0
  - displayName: "\uC5ED\uAD11"
    description: "\uB4A4\uC5D0\uC11C \uBE44\uCDB0 \uC724\uACFD\uB9CC \uBC1D\uB2E4. \uB9BC \uB77C\uC774\uD2B8\xB7\uD53C\uBD80 \uD22C\uACFC\uAD11 \uD655\uC778\uC6A9"
    useEnvironmentSun: 0
    sunAngles: {x: 20, y: 0}
    intensityScale: 1.2
    accentLights: 0
  - displayName: "\uD0D1\uB77C\uC774\uD2B8"
    description: "\uBA38\uB9AC \uC704\uC5D0\uC11C \uB0B4\uB9AC\uAF42\uB294 \uBE5B. \uB208\uB450\uB369\xB7\uD131 \uBC11 \uADF8\uB298 \uD655\uC778"
    useEnvironmentSun: 0
    sunAngles: {x: 85, y: 180}
    intensityScale: 1
    accentLights: 0
  - displayName: "3\uC810 \uC870\uBA85 + \uD3EC\uC778\uD2B8"
    description: "\uD658\uACBD \uD587\uBE5B + \uB530\uB73B\uD55C \uD3EC\uC778\uD2B8(\uD683\uBD88) + \uCC28\uAC00\uC6B4 \uC5ED\uAD11 \uD3EC\uC778\uD2B8. \uCD94\uAC00 \uB77C\uC774\uD2B8 \uD655\uC778\uC6A9"
    useEnvironmentSun: 1
    sunAngles: {x: 35, y: 180}
    intensityScale: 1
    accentLights: 1
